{
  "schemaVersion": 1,
  "id": "totem-vanilla-tweaks",
  "version": "${version}",
  "name": "TotemVanillaTweaks",
  "description": "Vanilla-focused gameplay tweaks for the Totem ecosystem, including container sorting, bookshelf rules, automation fixes, and privileged Spectator Observer View.",
  "authors": ["Yunitrish006006"],
  "license": "Apache-2.0",
  "icon": "assets/totem-vanilla-tweaks/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.totem.vanillatweaks.TotemVanillaTweaks"],
    "client": ["dev.totem.vanillatweaks.TotemVanillaTweaksClient"]
  },
  "mixins": [
    "totem-vanilla-tweaks.mixins.json",
    {
      "config": "totem-vanilla-tweaks.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=25",
    "totem-core": ">=0.7.0 <0.8.0"
  }
}
